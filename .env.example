# Database Connection String
DATABASE_URL=mysql://user:password@localhost:3306/brx_launchpad

# HTTP Server Configuration
PORT=3000
NODE_ENV=development

# Manus OAuth 2.0 Identity Portal Integration
VITE_APP_ID=your_manus_app_id
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
OAUTH_SERVER_URL=https://api.manus.im
JWT_SECRET=generate_a_random_high_entropy_32_char_string_here

# Web3 Wallet Configuration (RainbowKit & WalletConnect)
NEXT_PUBLIC_WAGMI_PROJECT_ID=your_walletconnect_project_id

# Amazon S3 Document Storage (KYC Verifications Uploads)
S3_BUCKET=your_bucket_name
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# External Integration API Configuration
BUILT_IN_FORGE_API_KEY=your_api_key
BUILT_IN_FORGE_API_URL=https://api.manus.im

# Sentry Error Tracing Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn
