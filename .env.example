# ─────────────────────────────────────────────────────────────────
#  Bitraxx BRX Launchpad — Environment Variables Reference
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# Database Connection (MySQL — PlanetScale / Railway / AWS RDS recommended)
DATABASE_URL=mysql://user:password@host:3306/brx_launchpad

# Server
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web3 Auth — iron-session (SIWE)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate_a_cryptographically_random_64_char_hex_string_here

# Web3 Wallet — RainbowKit & WalletConnect
# Get your project ID at: https://cloud.walletconnect.com
NEXT_PUBLIC_WAGMI_PROJECT_ID=your_walletconnect_project_id

# Amazon S3 — KYC Document Storage
S3_BUCKET=your_bucket_name
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Sentry Error Tracking (Optional but strongly recommended for production)
SENTRY_DSN=your_sentry_dsn
